# ── Volalte Node API — environment ───────────────────────────────────────────
# Copy to .env for local (non-docker) dev. In docker-compose these are passed
# via the compose file / a root .env consumed by compose.

# Server
NODE_ENV=development
PORT=3001
# CORS allow-list for the web origin (comma-separated) or * for any
WEB_ORIGIN=*

# MongoDB
MONGO_URI=mongodb://localhost:27017/volalte

# ── SIGNUS integration ───────────────────────────────────────────────────────
# mock  → serve the anonymized fixture (demo, never needs credentials)
# live  → hit the real SIGNUS REST API (requires user/pass)
SIGNUS_MODE=mock
SIGNUS_USER=
SIGNUS_PASS=
SIGNUS_CRC_CODE=R0805
SIGNUS_BASE_URL=https://aplicacion.signus.es/api/rest
SIGNUS_LOOKBACK_MONTHS=3

# ── Optimization engine (Python OR-Tools service) ────────────────────────────
ENGINE_URL=http://localhost:8000
# Shared secret — MUST match the engine's ENGINE_API_KEY. Empty disables the guard.
ENGINE_API_KEY=demo-engine-key
ENGINE_TIMEOUT_MS=90000

# ── Sync cron ────────────────────────────────────────────────────────────────
# node-cron expression; default hourly at minute 5
SYNC_CRON=5 * * * *
SYNC_ON_BOOT=true

# ── Auth (CHANGE THESE IN PRODUCTION) ────────────────────────────────────────
JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ── Operational defaults (seed the runtime Settings doc; editable in the UI) ──
COMPANY_NAME=Volalte
ACCENT_COLOR=#0f766e
DEFAULT_TRUCK_CAPACITY_KG=3200
DEPOT_LAT=41.7230
DEPOT_LNG=1.8266
SMALL_TIRE_KG=8.58
MEDIUM_TIRE_KG=59
URGENCY_THRESHOLD_DAYS=2
CAPACITY_TARGET_PCT=80
WORKDAY_START_HOUR=8
WORKDAY_LENGTH_HOURS=9
MAX_TOURS_PER_DRIVER=3

# Seed password for demo accounts
DEMO_PASSWORD=volalte

LOG_LEVEL=info
