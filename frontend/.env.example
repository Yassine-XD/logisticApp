# Frontend build config.
# In production the app is served from the same origin as the API, so leave
# VITE_API_URL unset (defaults to /api). Set it only for split-origin dev.
# VITE_API_URL=http://localhost:3001/api

# Dev-only: where `vite` proxies /api during `npm run dev`.
VITE_API_TARGET=http://localhost:3001
